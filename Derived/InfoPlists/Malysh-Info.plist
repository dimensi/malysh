	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MalyshAppGroup</key>
	<string>$(MALYSH_APP_GROUP)</string>
	<key>MalyshCloudKitContainer</key>
	<string>$(MALYSH_CLOUDKIT_CONTAINER)</string>
	<key>MalyshWidgetURLScheme</key>
	<string>$(MALYSH_WIDGET_URL_SCHEME)</string>
