require "shellwords"
require_relative "testflight_delivery"

def required_environment(name)
  value = ENV.fetch(name, "")
  UI.user_error!("Required environment variable is missing: #{name}") if value.empty?
  value
end

def release_version
  tag = required_environment("RELEASE_TAG")
  UI.user_error!("Release tag must match vX.Y.Z") unless tag.match?(/\Av[0-9]+\.[0-9]+\.[0-9]+\z/)
  UI.user_error!("Uploads are allowed only for a tag workflow") unless ENV["GITHUB_REF_TYPE"] == "tag"
  tag.delete_prefix("v")
end

default_platform(:ios)

platform :ios do
  desc "Deliver a signed version-tag release and confirm internal TestFlight availability"
  lane :beta do
    version = release_version
    api_key = app_store_connect_api_key(
      key_id: required_environment("ASC_KEY_ID"),
      issuer_id: required_environment("ASC_ISSUER_ID"),
      key_filepath: required_environment("ASC_KEY_PATH"),
      in_house: false
    )
    app = Spaceship::ConnectAPI::App.find(TestFlightDelivery::APP_IDENTIFIER)
    UI.user_error!("Malysh was not found in App Store Connect") unless app
    group = TestFlightDelivery.internal_group(app.id)
    existing = TestFlightDelivery.find_build(app.id, version)
    build_number = existing&.version || "1"
    if existing
      UI.message("Build #{version} (#{build_number}) is already registered with Apple. Checking availability.")
    else
      upload_release(api_key: api_key, version: version, build_number: build_number)
    end
    TestFlightDelivery.wait(app.id, group, version, build_number) do |status|
      UI.message("TestFlight #{version} (#{build_number}): #{status}")
    end
    UI.success("TestFlight #{version} (#{build_number}) is available to #{TestFlightDelivery::GROUP_NAME}")
  rescue TestFlightDelivery::Error => error
    UI.user_error!(error.message)
  end

  private_lane :upload_release do |options|
    api_key = options.fetch(:api_key)
    version = options.fetch(:version)
    build_number = options.fetch(:build_number)
    profile = required_environment("PROFILE_UUID")
    widget_profile = required_environment("WIDGET_PROFILE_UUID")
    watch_profile = required_environment("WATCH_PROFILE_UUID")
    watch_widget_profile = required_environment("WATCH_WIDGET_PROFILE_UUID")
    keychain = required_environment("CI_KEYCHAIN_PATH")
    settings = {
      "CODE_SIGN_STYLE" => "Manual",
      "CODE_SIGN_IDENTITY" => "Apple Distribution",
      "MALYSH_PROFILE_UUID" => profile,
      "MALYSH_WIDGET_PROFILE_UUID" => widget_profile,
      "MALYSH_WATCH_PROFILE_UUID" => watch_profile,
      "MALYSH_WATCH_WIDGET_PROFILE_UUID" => watch_widget_profile,
      "DEVELOPMENT_TEAM" => "YBBAN7R28K",
      "MARKETING_VERSION" => version,
      "CURRENT_PROJECT_VERSION" => build_number.to_s,
      "CLOUDKIT_ENVIRONMENT" => "Production",
      "APS_ENVIRONMENT" => "production",
      "OTHER_CODE_SIGN_FLAGS" => "--keychain #{Shellwords.escape(keychain)}"
    }
    ipa = build_app(
      workspace: "Malysh.xcworkspace",
      scheme: "Malysh",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_team_id: "YBBAN7R28K",
      output_directory: "Artifacts/TestFlight",
      output_name: "Malysh.ipa",
      buildlog_path: "Artifacts/BuildLogs",
      archive_path: "Artifacts/TestFlight/Malysh.xcarchive",
      skip_profile_detection: true,
      export_options: {
        signingStyle: "manual",
        teamID: "YBBAN7R28K",
        signingCertificate: "Apple Distribution",
        iCloudContainerEnvironment: "Production",
        provisioningProfiles: {
          "dev.dimensi.malysh" => profile,
          "dev.dimensi.malysh.widgets" => widget_profile,
          "dev.dimensi.malysh.watchkitapp" => watch_profile,
          "dev.dimensi.malysh.watchkitapp.widgets" => watch_widget_profile
        },
        manageAppVersionAndBuildNumber: false
      },
      xcargs: settings.map { |key, value| "#{key}=#{Shellwords.escape(value)}" }.join(" ")
    )
    app_info = File.expand_path("../Artifacts/TestFlight/Malysh.xcarchive/Products/Applications/Malysh.app/Info.plist", FastlaneCore::FastlaneFolder.path)
    { "CFBundleShortVersionString" => version, "CFBundleVersion" => build_number.to_s,
      "MinimumOSVersion" => TestFlightDelivery::MINIMUM_IOS,
      "ITSAppUsesNonExemptEncryption" => "false" }.each do |key, expected|
      actual = sh("/usr/libexec/PlistBuddy", "-c", "Print :#{key}", app_info, log: false).strip
      UI.user_error!("Archived #{key} does not match the intended release") unless actual == expected
    end
    widget_info = File.join(File.dirname(app_info), "PlugIns/MalyshWidgets.appex/Info.plist")
    UI.user_error!("Archived widget extension is missing") unless File.file?(widget_info)
    { "CFBundleIdentifier" => "dev.dimensi.malysh.widgets",
      "CFBundleShortVersionString" => version, "CFBundleVersion" => build_number.to_s,
      "MinimumOSVersion" => TestFlightDelivery::MINIMUM_IOS }.each do |key, expected|
      actual = sh("/usr/libexec/PlistBuddy", "-c", "Print :#{key}", widget_info, log: false).strip
      UI.user_error!("Archived widget #{key} does not match the intended release") unless actual == expected
    end
    watch_app = File.join(File.dirname(app_info), "Watch/MalyshWatch.app")
    {
      File.join(watch_app, "Info.plist") => "dev.dimensi.malysh.watchkitapp",
      File.join(watch_app, "PlugIns/MalyshWatchWidgets.appex/Info.plist") => "dev.dimensi.malysh.watchkitapp.widgets"
    }.each do |info, bundle_id|
      UI.user_error!("Archived bundle is missing: #{bundle_id}") unless File.file?(info)
      { "CFBundleIdentifier" => bundle_id,
        "CFBundleShortVersionString" => version,
        "CFBundleVersion" => build_number.to_s,
        "MinimumOSVersion" => "26.0" }.each do |key, expected|
        actual = sh("/usr/libexec/PlistBuddy", "-c", "Print :#{key}", info, log: false).strip
        UI.user_error!("Archived #{bundle_id} #{key} does not match the intended release") unless actual == expected
      end
    end
    companion = sh("/usr/libexec/PlistBuddy", "-c", "Print :WKCompanionAppBundleIdentifier",
                   File.join(watch_app, "Info.plist"), log: false).strip
    UI.user_error!("Archived watch app points to the wrong iPhone app") unless companion == TestFlightDelivery::APP_IDENTIFIER
    begin
      upload_to_testflight(
        api_key: api_key,
        ipa: ipa,
        app_identifier: TestFlightDelivery::APP_IDENTIFIER,
        skip_waiting_for_build_processing: true,
        skip_submission: true,
        distribute_external: false,
        notify_external_testers: false
      )
    rescue FastlaneCore::Interface::FastlaneError
      UI.important("Uploader reported an error. Checking App Store Connect without sending another build.")
    end
  end
end
